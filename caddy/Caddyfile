{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:{$API_PORT:3000}
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
