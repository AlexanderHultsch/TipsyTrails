# Tipsy Trails — environment configuration
#
# Copy this file to `.env` and fill in the blank values. `.env` is gitignored
# and must never be committed — this file documents variable names and
# shapes only, never real values (SPEC.md constraint C6).

# --- Runtime ---
NODE_ENV=production

# --- API server (see packages/api/src/env.ts) ---
API_HOST=0.0.0.0
# PORT is accepted as an alias for API_PORT (the name the Raspberry Pi's
# multi-site platform supplies to every container it runs). If both are set,
# API_PORT wins.
#
# The standalone docker-compose.yml resolves that same pair the same way and
# gives the result to Caddy as well, so the reverse proxy follows whichever of
# the two you set (see SPEC.md Section 4.3). This is also the one variable
# here that may be exported in the shell instead of written into .env:
# Compose reads it from there too, and passes the same value on to the API.
API_PORT=3000

# Public origin the app is served at. Required — the app refuses to boot
# without it — and must be an http: or https: URL: the session cookie takes
# its `secure` flag from the scheme, the CSRF origin check compares against
# this value, and Web Push uses it as the VAPID subject.
PUBLIC_ORIGIN=https://tipsytrails.ahultsch.com

# Path to the SQLite database file inside the api container. Must live under
# the directory bind-mounted from ./data/db (see docker-compose.yml).
# DB_PATH is accepted as an alias for DATABASE_PATH (the name the Raspberry
# Pi's multi-site platform supplies). If both are set, DATABASE_PATH wins.
DATABASE_PATH=/data/db/tipsy.db

# Absolute path to the built SPA that the API serves via @fastify/static.
# Optional: defaults to ../public relative to the compiled server, which is
# where the root Dockerfile places it. Only needed to override that default,
# so it is left unset here rather than given an empty value.
# WEB_ROOT=/path/to/built/spa

# Directory containing the PMTiles map extract served at /tiles/<filename>
# (see packages/api/src/env.ts). Must live under a persistent data volume, the
# same one DATABASE_PATH lives under. Optional: defaults to /data/tiles.
# TILES_DIR=/data/tiles

# Directory containing the committed per-city seed data (data/seed/<slug>/)
# served at /static/<slug>/<filename>. Optional: defaults to ../../data/seed
# relative to the compiled server, which is where the root Dockerfile places
# it. Only needed to override that default, so it is left unset here rather
# than given an empty value.
# SEED_DIR=/path/to/data/seed

# Signs session cookies, and is also the HMAC key behind the decoy security
# question GET /api/auth/reset/question returns for an unknown username
# (SPEC.md Section 9.5). Changing it therefore invalidates every existing
# session and changes every decoy question. At least 32 characters, or the
# app refuses to boot. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Seed the admin account (SPEC.md Sections 4.3, 5.3). Both are read on every
# boot, and boot-time seeding only ever creates: if a user with this username
# already exists, it is left exactly as it is, so a restart can never revert a
# password the admin changed in the app.
#
# The seeded account has must_change_password = 0 — deliberately. There is no
# forced password change at first sign-in, because on the Pi the platform
# supplies and rotates this credential, and forcing a change would invalidate
# the only managed way in.
#
# One command does rewrite an existing account's password:
# `npm run seed:admin -- --rotate-password` sets password_hash from
# ADMIN_PASSWORD and, in the same transaction, deletes every session that
# account holds — so a rotation signs the admin out, on purpose. The `--` is
# npm's argument separator and is required. `deploy.sh --set-password` is how
# the Pi reaches it; nothing else rotates, and an ordinary deploy does not.
#
# On the Pi's multi-site platform these are supplied by the platform itself,
# from a shared ~/pi-server/admin.env (SPEC.md Section 4.3) — only set them
# here for the standalone deployment path.
ADMIN_USER=
ADMIN_PASSWORD=

# Web Push (see packages/api/src/push/config.ts, SPEC.md Section 5.9). The
# app generates its own VAPID key pair on first boot and persists it beside
# the database (in DATABASE_PATH's directory), so these three are no longer
# required for push to work — omit all of them and push is on by default,
# using the generated key and PUBLIC_ORIGIN as the subject. Setting all
# three overrides the generated/persisted key outright, for a deployment
# that wants to pin its own — useful for local development. Setting only
# some of the three is treated as a misconfiguration and logged as a warning
# at boot, so either set none or all three. Generate a keypair with:
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is not secret and is also served to the client at
# GET /api/push/vapid-public-key. VAPID_PRIVATE_KEY is a secret, like every
# other value in this file it must never be filled in here (CLAUDE.md, C6).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI the push service can reach if it needs to reach the sender —
# either a mailto: address or an https: URL. Only needed alongside the two
# keys above; omit it too when relying on the generated key pair.
VAPID_SUBJECT=

# Admin teleport (see packages/api/src/routes/admin-teleport.ts, SPEC.md
# Sections 9.3, 10.1). A testing tool: it moves an admin's own position to a
# point chosen on a map in the admin panel, ignoring the two speed guards,
# and what it writes is real — fog, discoveries and visit progress all count.
#
# LEAVE IT UNSET IN PRODUCTION. Unset — the default, and what this file
# documents — means the route is never registered, so POST /api/admin/teleport
# answers 404 rather than 403 and the code ships inert. The only value that
# turns it on is the exact string `true`; `false` is accepted as an explicit
# "off". Anything else (`1`, `yes`, `on`, `TRUE`) fails at boot naming the
# variable, rather than quietly leaving the feature off.
#
# It is not a secret and there is nothing here to fill in, so it is left
# commented out rather than given an empty value — the same treatment
# WEB_ROOT, SEED_DIR and TILES_DIR get above.
#
# Turning it on is not by itself enough to teleport: the calling account must
# also already be excluded from the rankings (Admin → Users), which is what
# makes it impossible for anything a teleport writes to become a leaderboard
# place or a badge.
# ADMIN_TELEPORT_ENABLED=true

# --- Reverse proxy (see caddy/Caddyfile, docker-compose.yml) ---
# Host port Caddy publishes. The existing Cloudflare Tunnel (already running
# on the Pi, configured outside this repository) must point at this port.
HTTP_PORT=8080
